# Local development (uvicorn / celery on the host).
# Docker Compose overrides DATABASE_URL and REDIS_URL to use service DNS names.

APP_NAME=RelayFlow
DEBUG=false

DATABASE_URL=postgresql+asyncpg://relayflow:relayflow@localhost:5432/relayflow
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production

# Optional: leave unset to reuse REDIS_URL.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Per-tenant ingest token bucket (tokens / second). Outbound uses each endpoint's rate_limit_per_sec.
INGEST_RATE_LIMIT_PER_SEC=50
